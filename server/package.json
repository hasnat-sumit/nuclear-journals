{
  "name": "nuclear-journal-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/build-vercel.mjs",
    "start": "node dist/server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:db": "tsx scripts/dev-db.ts",
    "seed": "tsx scripts/seed.ts",
    "make-editor": "tsx scripts/make-editor.ts"
  },
  "dependencies": {
    "better-auth": "^1.7.18",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "mongodb": "~7.8",
    "mongoose": "^9.12.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "sanitize-html": "^2.18.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^7.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.1.0"
  }
}
