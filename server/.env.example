# Copy to server/.env for local development. Never commit the real .env.

NODE_ENV=development
PORT=4000

# The website address(es) allowed to call the API, comma-separated, no trailing slash.
CLIENT_ORIGINS=http://localhost:3000
# How many proxies sit in front of the API in production (0 locally).
TRUST_PROXY_HOPS=0
# Requests per address per 15 minutes.
RATE_LIMIT_MAX=300

# Local: `npm run dev:db` serves this address. Production: your MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27018/nuclear-journal

# At least 32 random characters in production, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=local-development-only-secret-do-not-deploy
# The public website address. The browser reaches the API through the website.
BETTER_AUTH_URL=http://localhost:3000

# Leave blank locally: emails are printed in the API terminal instead.
SMTP_URL=
EMAIL_FROM=Nuclear Journal <no-reply@nuclearjournal.example>

# Must match INTERNAL_API_KEY in client/.env.local. At least 32 characters in production.
INTERNAL_API_KEY=local-development-internal-key-do-not-deploy

# cloudinary://<api_key>:<api_secret>@<cloud_name>. Needed for image uploads.
CLOUDINARY_URL=

# Google sign-in. Leave both blank to turn it off. See "Google sign-in" in the README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
