# Copy to client/.env.local for local development. Never commit the real file.

# Where the Express API runs. The website forwards /api/v1 requests here.
API_URL=http://localhost:4000

# Must match INTERNAL_API_KEY in server/.env.
INTERNAL_API_KEY=local-development-internal-key-do-not-deploy

# The public website address, used for links in the sitemap and metadata.
SITE_URL=http://localhost:3000

# Shown on the contact page.
CONTACT_EMAIL=editors@nuclearjournal.example
